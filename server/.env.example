# Server Port (default: 5000)
PORT=5000

# Gmail credentials for Nodemailer
# Use your Gmail address below
EMAIL_USER=pratham.pancahl0626@gmail.com

# Generate an App Password (NOT your regular Gmail password):
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to App Passwords → Select "Mail" → Generate
# 4. Paste the 16-character password below (never commit the real password)
EMAIL_PASS=your-gmail-app-password

# Where Let's Talk messages should arrive
RECIPIENT_EMAIL=prathampanchal1515@gmail.com
